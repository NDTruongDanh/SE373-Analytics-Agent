  "cards": [
    {
      "dot": "cyan",
      "title": "Five Harness Invariants",
      "items": [
        "Single DB gateway: packages/agent has zero pg imports (ESLint enforced)",
        "4-layer defense: AST sqlGuard, agent_ro read-only DB, AccessPolicy + PII scan, RLS (planned)",
        "Prompt injection isolation: escaped untrusted_data tags + zero tools on Profile 3 synthesizer",
        "Identity from Bearer token via mcp_clients.yaml; X-Run-Id/X-User-Id correlate traces only"
      ]
    },
    {
      "dot": "emerald",
      "title": "Bounded Loops & K7 Gates",
      "items": [
        "ValidatedQueryExecutor: selective describe, anti-fanout gate, ≤3 SQL repairs, 1-pass zero-row probe",
        "UC-05 RCA & UC-10 Alerts: HITL interrupt(), depth ≤4 / ≤20 queries, trimmed z-score + 24h dedup",
        "K7 verification: 100% catalog citations, headless render_chart, ≤1% numeric & ≤5% attribution math",
        "Budget circuit breaker routes to a deterministic template with zero extra LLM calls"
      ]
    },
    {
      "dot": "rose",
      "title": "MCP 7-Stage Pipeline & Roles",
      "items": [
        "Fixed order: Auth → Scope → Zod → sqlGuard → AccessPolicy → agent_ro cursor → PII scan & audit",
        "4 isolated DB roles: owner (seed only), agent_ro (MCP SELECT), indexer (RAG CLI), harness_state (API)",
        "External UC-09 clients connect over Streamable HTTP with scoped tokens and never bypass policy",
        "Spec status: monorepo foundation & contracts built; UC subgraphs & Wave 1–3 hardening planned"
      ]
    }
  ]
