{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "se373-analytics-agent",
  "version": "0.1.0",
  "private": true,
  "description": "SE373 Analytics Agent — Agentic AI Engineering course project",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:reset": "docker compose -f docker/docker-compose.yml down -v && docker compose -f docker/docker-compose.yml up -d",
    "demo:tracer": "tsx scripts/demo-tracer.ts",
    "wiki:init": "node --import ./scripts/openwiki-fetch-patch.mjs ./node_modules/openwiki/dist/cli/cli.js code --init",
    "wiki:update": "node --import ./scripts/openwiki-fetch-patch.mjs ./node_modules/openwiki/dist/cli/cli.js code --update",
    "wiki:update:print": "node --import ./scripts/openwiki-fetch-patch.mjs ./node_modules/openwiki/dist/cli/cli.js code --update --print",
    "wiki:dry-run": "node --import ./scripts/openwiki-fetch-patch.mjs ./node_modules/openwiki/dist/cli/cli.js --dry-run",
    "wiki:visualize": "node --import ./scripts/openwiki-fetch-patch.mjs ./node_modules/openwiki/dist/cli/cli.js visualize",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "docs:interface": "tsx scripts/generate-interface.mjs"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "mermaid": "11.16.0",
    "openwiki": "0.7.2",
    "typescript": "~6.0.3",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "tsx": "^4.23.15"
  }
}
