# Keep the build context to what the image actually needs.
.git
.github
.gitignore
.planning
.vscode

# Never bake local secrets or local env files into an image.
.env
.env.*
!.env.example

# Host dependencies and previous build output are rebuilt inside the image.
node_modules
**/node_modules
**/dist
**/*.tsbuildinfo
coverage

# Runtime output (compose bind-mounts these from the repo).
traces
logs
results

# Documentation, generated wiki, evals, and the publisher cache are not
# needed to run the services (the data loader re-downloads its cache).
docs
openwiki
evals
data/.cache
