# dependencies
node_modules/
.pnpm-store/

# local env (secret keys) — commit only .env.example
.env
.env.local

# OpenWiki transient run state (removed in CI too; never commit)
openwiki/.run.json

# OS / editor
.DS_Store
Thumbs.db

# TS project-reference build output (never commit)
dist/
*.tsbuildinfo

# Generated runtime outputs (01-01 tracer; curated evidence committed explicitly)
traces/*.jsonl
logs/*.jsonl
results/
# keep skeleton dirs tracked via their .gitkeep files
!traces/.gitkeep
!logs/.gitkeep

# GSD skill working state (local planning artifacts — never commit)
.planning/
