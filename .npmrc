# pnpm behaviour for this monorepo (no new tooling).
# - engine-strict: respect node/pnpm engines in package.json (Node >=24, pnpm >=10).
# - node-linker=isolated: keep default pnpm symlinks for @shared/* workspace
#   packages (this is intentional — not custom). Never hand-copy node_modules;
#   always repair with `pnpm install --frozen-lockfile`.
engine-strict=true
node-linker=isolated
