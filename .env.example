# Copy to `.env` for local runs (never commit `.env`).
# In GitHub Actions these come from repository Secrets instead — you only need
# to create the secrets, not commit any key here.

# --- Inference provider: OpenCode Go via OpenWiki's openai-compatible provider ---
OPENWIKI_PROVIDER=openai-compatible
# Your OpenCode Go API key. Paste the value yourself:
# - locally: set it in `.env` or export it before running pnpm wiki:update
# - CI: save it as the `OPENCODE_GO_API_KEY` Actions secret (Settings →
#   Secrets and variables → Actions). The workflow maps it to this variable.
OPENAI_COMPATIBLE_API_KEY=
# OpenCode Go OpenAI-compatible base URL (no trailing path segment for a
# specific transport; OpenWiki appends `/responses` when
# OPENWIKI_OPENAI_COMPATIBLE_USE_RESPONSES_API=true).
OPENAI_COMPATIBLE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Responses-only Go model. Keep pinned unless you intentionally switch models.
OPENWIKI_MODEL_ID=muse-spark-1.3-contributor
# MUST stay true for muse-spark-1.3-contributor: Go serves it ONLY on the
# Responses API. Setting false routes to /chat/completions and Go answers
# ModelProtocolUnsupported (surfaced as HTTP 401, which looks like bad auth).
OPENWIKI_OPENAI_COMPATIBLE_USE_RESPONSES_API=true

# --- x-opencode-session header (mandatory on every Go request) ---
# Optional override. When unset, scripts/openwiki-fetch-patch.mjs derives a
# stable opaque `ses_<32 hex>` id automatically: deterministic per GitHub run
# in CI (repo+run_id+sha), random per process locally. Set this only to pin a
# value for tracing a specific run. Must match `ses_[0-9a-f]{32}`.
# OPENWIKI_OPENCODE_SESSION_ID=

# --- Optional: LangSmith tracing of OpenWiki runs ---
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=openwiki
# LANGCHAIN_TRACING_V2=true

# --- Optional: silence OpenWiki's anonymous reliability telemetry ---
# OPENWIKI_TELEMETRY_DISABLED=1
